#!/usr/bin/env python3
"""figma — thin, stdlib-only wrapper over the Figma REST API for reading design files.

Read-only. No third-party deps. Auth via a Figma personal access token.

Token resolution (first hit wins):
  1. $FIGMA_TOKEN
  2. ~/.figma.env  (chmod 600; a line `FIGMA_TOKEN=figd_...` or `export FIGMA_TOKEN=figd_...`)

Commands:
  figma tree   <file|url> [node] [--depth N] [--text]   compact indented outline of a node's subtree
  figma nodes  <file|url> <node...> [--depth N]          raw JSON for one or more nodes
  figma image  <file|url> <node...> [--scale S] [--format png|svg|pdf] [-o DIR]
                                                         render node(s) and download to DIR (default cwd)
  figma file   <file|url> [--depth N]                    raw JSON for the whole file (can be huge)
  figma whoami                                           verify the token works (GET /v1/me)

Accepts either a bare file key or a full figma.com URL, and node ids in either
`16148-59` or `16148:59` form.
"""
import argparse
import json
import os
import re
import sys
import urllib.error
import urllib.parse
import urllib.request

API = "https://api.figma.com/v1"


def load_token():
    tok = os.environ.get("FIGMA_TOKEN")
    if tok:
        return tok.strip()
    envpath = os.path.expanduser("~/.figma.env")
    if os.path.exists(envpath):
        with open(envpath) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                m = re.match(r"(?:export\s+)?FIGMA_TOKEN\s*=\s*(.+)", line)
                if m:
                    return m.group(1).strip().strip('"').strip("'")
    sys.exit(
        "No Figma token found. Set $FIGMA_TOKEN or add FIGMA_TOKEN=figd_... to "
        "~/.figma.env (chmod 600). Generate one at Figma → Settings → Security → "
        "Personal access tokens (scope: File content read)."
    )


def api_get(path, params=None):
    url = f"{API}{path}"
    if params:
        url += "?" + urllib.parse.urlencode(params)
    req = urllib.request.Request(url, headers={"X-Figma-Token": load_token()})
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8", "replace")
        sys.exit(f"Figma API {e.code} on {path}: {body}")
    except urllib.error.URLError as e:
        sys.exit(f"Network error reaching Figma: {e}")


def parse_file_key(s):
    """Accept a bare key or a full figma URL (/design/<key>/... or /file/<key>/...)."""
    m = re.search(r"figma\.com/(?:design|file|proto)/([A-Za-z0-9]+)", s)
    if m:
        return m.group(1)
    return s.strip()


def norm_node(n):
    """Normalize a node id to the API's colon form; leave URLs' dash form aside."""
    return n.replace("-", ":", 1) if re.match(r"^\d+-\d+$", n) else n


def cmd_whoami(a):
    me = api_get("/me")
    print(json.dumps(me, indent=2, ensure_ascii=False))


def _walk(node, depth, indent, show_text, out):
    name = node.get("name", "?")
    ntype = node.get("type", "?")
    nid = node.get("id", "")
    line = f"{'  ' * indent}- {name}  [{ntype}] {nid}"
    if show_text and ntype == "TEXT" and node.get("characters"):
        txt = node["characters"].replace("\n", " ⏎ ")
        line += f'  «{txt[:120]}»'
    out.append(line)
    if depth is not None and indent >= depth:
        return
    for c in node.get("children", []) or []:
        _walk(c, depth, indent + 1, show_text, out)


def cmd_tree(a):
    key = parse_file_key(a.file)
    if a.node:
        nid = norm_node(a.node)
        params = {"ids": nid}
        if a.depth is not None:
            params["depth"] = a.depth
        data = api_get(f"/files/{key}/nodes", params)
        roots = [v["document"] for v in data.get("nodes", {}).values() if v]
    else:
        params = {}
        if a.depth is not None:
            params["depth"] = a.depth
        data = api_get(f"/files/{key}", params)
        roots = [data["document"]]
    out = []
    for root in roots:
        _walk(root, a.depth, 0, a.text, out)
    print("\n".join(out) if out else "(no nodes returned)")


def cmd_nodes(a):
    key = parse_file_key(a.file)
    ids = ",".join(norm_node(n) for n in a.node)
    params = {"ids": ids}
    if a.depth is not None:
        params["depth"] = a.depth
    print(json.dumps(api_get(f"/files/{key}/nodes", params), indent=2, ensure_ascii=False))


def cmd_file(a):
    key = parse_file_key(a.file)
    params = {}
    if a.depth is not None:
        params["depth"] = a.depth
    print(json.dumps(api_get(f"/files/{key}", params), indent=2, ensure_ascii=False))


def cmd_image(a):
    key = parse_file_key(a.file)
    ids = [norm_node(n) for n in a.node]
    params = {"ids": ",".join(ids), "scale": a.scale, "format": a.format}
    data = api_get(f"/images/{key}", params)
    if data.get("err"):
        sys.exit(f"Figma image render error: {data['err']}")
    outdir = os.path.abspath(a.o)
    os.makedirs(outdir, exist_ok=True)
    saved = []
    for nid, url in (data.get("images") or {}).items():
        if not url:
            print(f"  (no render for {nid})", file=sys.stderr)
            continue
        fname = f"{nid.replace(':', '-')}.{a.format}"
        dest = os.path.join(outdir, fname)
        try:
            with urllib.request.urlopen(url, timeout=120) as r, open(dest, "wb") as f:
                f.write(r.read())
            saved.append(dest)
            print(dest)
        except Exception as e:
            print(f"  download failed for {nid}: {e}", file=sys.stderr)
    if not saved:
        sys.exit("No images downloaded.")


def main():
    p = argparse.ArgumentParser(prog="figma", description="Read Figma design files via the REST API.")
    sub = p.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("whoami"); sp.set_defaults(fn=cmd_whoami)

    sp = sub.add_parser("tree")
    sp.add_argument("file"); sp.add_argument("node", nargs="?")
    sp.add_argument("--depth", type=int); sp.add_argument("--text", action="store_true")
    sp.set_defaults(fn=cmd_tree)

    sp = sub.add_parser("nodes")
    sp.add_argument("file"); sp.add_argument("node", nargs="+")
    sp.add_argument("--depth", type=int); sp.set_defaults(fn=cmd_nodes)

    sp = sub.add_parser("file")
    sp.add_argument("file"); sp.add_argument("--depth", type=int); sp.set_defaults(fn=cmd_file)

    sp = sub.add_parser("image")
    sp.add_argument("file"); sp.add_argument("node", nargs="+")
    sp.add_argument("--scale", type=float, default=2.0)
    sp.add_argument("--format", choices=["png", "svg", "pdf"], default="png")
    sp.add_argument("-o", default=".")
    sp.set_defaults(fn=cmd_image)

    a = p.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
